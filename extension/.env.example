# Developer Groq fallback (baked into the service worker at build time).
# End users do NOT set this in the UI — Gemini Nano is primary; Groq is automatic.
# Priority at build: GROQ_API_KEY env → VITE_GROQ_API_KEY → root config.js HS_CONFIG.GROQ_API_KEY
# Never import this into content scripts.
VITE_GROQ_API_KEY=
VITE_CONVEX_HTTP_URL=https://ardent-partridge-610.convex.site
VITE_CONVEX_URL=https://ardent-partridge-610.convex.cloud
