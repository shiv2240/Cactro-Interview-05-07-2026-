{
  "manifest_version": 3,
  "name": "AI Knowledge Assistant",
  "version": "2.0.0",
  "description": "Load the unpacked build from extension/dist after npm run build. This root file documents the product version; Chrome should load extension/dist/manifest.json.",
  "permissions": [
    "storage",
    "sidePanel",
    "offscreen",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://*.convex.cloud/*",
    "https://*.convex.site/*"
  ],
  "action": {
    "default_title": "AI Knowledge Assistant — load extension/dist",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
